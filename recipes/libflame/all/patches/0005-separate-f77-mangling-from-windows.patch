--- a/configure.ac
+++ b/configure.ac
@@ -547,6 +547,27 @@
 dnl assembly.
 FLA_CHECK_ENABLE_PORTABLE_TIMER
 
+dnl Observe whether Fortran symbols omit the conventional trailing underscore.
+AC_ARG_ENABLE([f77-no-underscore],
+              AS_HELP_STRING([--enable-f77-no-underscore],[Use Fortran symbols without a trailing underscore. (Disabled by default.)]),
+[
+	if test "$enableval" = "no" ; then
+		fla_enable_f77_no_underscore=no
+	elif test "$enableval" = "yes" ; then
+		fla_enable_f77_no_underscore=yes
+	else
+		AC_MSG_ERROR([[Invalid option to --enable-f77-no-underscore]])
+	fi
+],
+[
+	fla_enable_f77_no_underscore=no
+])
+if test "$fla_enable_f77_no_underscore" = "yes" ; then
+	AC_DEFINE(FLA_ENABLE_F77_NO_UNDERSCORE,1,
+	          [Determines whether Fortran symbols omit the trailing underscore.])
+fi
+AC_SUBST(fla_enable_f77_no_underscore)
+
 dnl Observe whether we're building for Windows. (Note this actually never gets
 dnl invoked, because the Windows build doesn't use a configure script.)
 FLA_CHECK_ENABLE_WINDOWS_BUILD
