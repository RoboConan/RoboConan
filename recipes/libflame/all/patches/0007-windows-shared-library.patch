--- /dev/null
+++ b/build/filter-windows-def.py
@@ -0,0 +1,32 @@
+import sys
+
+
+data_symbols = (
+    "FLA_THREE", "FLA_TWO", "FLA_ONE", "FLA_ONE_HALF", "FLA_ZERO",
+    "FLA_MINUS_ONE_HALF", "FLA_MINUS_ONE", "FLA_MINUS_TWO", "FLA_MINUS_THREE",
+    "FLA_EPSILON", "FLA_SAFE_MIN", "FLA_SAFE_MIN_SQUARE", "FLA_SAFE_INV_MIN",
+    "FLA_SAFE_INV_MIN_SQUARE", "FLA_UNDERFLOW_THRES", "FLA_OVERFLOW_THRES",
+    "FLA_UNDERFLOW_SQUARE_THRES", "FLA_OVERFLOW_SQUARE_THRES",
+    "fzero", "dzero", "czero", "zzero",
+)
+
+template_path, symbols_path, output_path = sys.argv[1:]
+
+with open(symbols_path, encoding="utf-8") as symbols_file:
+    defined = set()
+    for line in symbols_file:
+        fields = line.split()
+        if len(fields) == 2:
+            defined.add(fields[1])
+
+with open(template_path, encoding="utf-8") as template_file:
+    exports = [line.strip().split()[0] for line in template_file]
+
+with open(output_path, "w", encoding="utf-8", newline="\n") as output_file:
+    output_file.write("EXPORTS\n")
+    for symbol in data_symbols:
+        if symbol in defined:
+            output_file.write(f"{symbol} DATA\n")
+    for symbol in exports:
+        if symbol not in data_symbols and symbol in defined:
+            output_file.write(f"{symbol}\n")
