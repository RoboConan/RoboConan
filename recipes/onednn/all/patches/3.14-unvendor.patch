diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -117,6 +117,28 @@ if(DNNL_AARCH64_USE_KAI)
     add_definitions_with_host_compiler(-DDNNL_AARCH64_USE_KAI=1)
